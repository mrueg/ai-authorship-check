{
  "name": "ai-authorship-check",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that reacts to issues, PRs and comments with 👍 (human) or 👎 (likely AI-generated) using a local ModernBERT classifier",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.corpus.json",
    "test": "vitest run",
    "eval": "node dist/eval.js"
  }
}
